---
// Portada de una ficha o nota. Sin imagen oficial, muestra la inicial sobre fucsia:
// nunca se usa una imagen que no venga del press kit o de la página de Steam.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  portada?: { archivo: ImageMetadata; alt: string; credito: string };
  nombre: string;
  /** Muestra el crédito debajo. En las tarjetas va apagado; en la ficha, siempre. */
  credito?: boolean;
  prioridad?: boolean;
}
const { portada, nombre, credito = false, prioridad = false } = Astro.props;
---

<figure class="portada">
  {
    portada ? (
      <Image
        src={portada.archivo}
        alt={portada.alt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 60rem) 36rem, 100vw"
        loading={prioridad ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="portada__vacia" aria-hidden="true">
        <span>{nombre.trim().charAt(0).toUpperCase()}</span>
      </div>
    )
  }
  {portada && credito && <figcaption class="apagado">Imagen: {portada.credito}</figcaption>}
</figure>

<style>
  .portada {
    margin: 0;
  }
  .portada :global(img),
  .portada__vacia {
    width: 100%;
    aspect-ratio: 616 / 353;
    object-fit: cover;
    border-radius: calc(var(--radio) - 2px);
  }
  .portada__vacia {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 20% 25%, rgb(255 255 255 / 0.18) 0 12%, transparent 13%),
      radial-gradient(circle at 82% 78%, rgb(74 52 38 / 0.22) 0 18%, transparent 19%), var(--fucsia);
    color: var(--crema);
    font: 800 clamp(3rem, 12vw, 5rem) var(--titulos);
  }
  figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
  }
</style>
