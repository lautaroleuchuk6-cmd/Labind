---
import { fechaCorta, fechaIso, seccion, urlNota, type Nota } from '../lib/contenido';

interface Props {
  nota: Nota;
  /** Oculta la etiqueta de sección cuando ya estamos dentro de ella. */
  sinSeccion?: boolean;
}
const { nota, sinSeccion = false } = Astro.props;
const { data } = nota;
---

<article class="tarjeta nota">
  <ul class="etiquetas">
    {!sinSeccion && <li><span class="etiqueta">{seccion(data.seccion).titulo}</span></li>}
    {data.rumor && <li><span class="etiqueta etiqueta--oscura">Rumor {data.rumor}</span></li>}
    {data.patrocinado && <li><span class="etiqueta etiqueta--oscura">Patrocinado</span></li>}
    {data.borrador && <li><span class="etiqueta etiqueta--borrador">Borrador</span></li>}
  </ul>
  <h3><a href={urlNota(nota)}>{data.titulo}</a></h3>
  <p>{data.descripcion}</p>
  <time class="apagado" datetime={fechaIso(data.fecha)}>{fechaCorta(data.fecha)}</time>
</article>

<style>
  .nota {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.15rem 1rem;
    height: 100%;
  }
  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.3rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radio);
  }
  .nota:hover h3 a {
    text-decoration: underline;
  }
  p {
    margin: 0;
    flex: 1;
  }
</style>
